{
  "html": "<div class=\"content\"><div class=\"row page-content\" ng-cloak=\"\" ng-controller=\"friendsController\" ng-modules=\"robloxApp, friends\"><div ng-include=\"'system-feedback'\"></div><div class=\"section\"><div class=\"container-header\"><h1 class=\"friends-title\" ng-bind=\"'Heading.MyFriends' | translate\" ng-show=\"currentData.isMyProfile\"></h1><h1 ng-hide=\"currentData.isMyProfile\"><span class=\"friends-title\" ng-bind=\"'Heading.UsersFriends' | translate:{username:currentData.userName}\"></span></h1></div></div><div class=\"rbx-tabs-horizontal\"><ul class=\"nav nav-tabs\" id=\"horizontal-tabs\" role=\"tablist\"><li class=\"rbx-tab\" id=\"friends\" ng-class=\"{'active': currentData.activeTab == 'friends', 'subtract-item': !currentData.isMyProfile}\" ui-sref=\"friends\"><a class=\"rbx-tab-heading\"> <span class=\"text-lead\" ng-bind=\"'Label.Friends' | translate\"></span> </a></li><li class=\"rbx-tab\" id=\"following\" ng-class=\"{'active': currentData.activeTab == 'following', 'subtract-item': !currentData.isMyProfile}\" ui-sref=\"following\"><a class=\"rbx-tab-heading\"> <span class=\"text-lead\" ng-bind=\"'Label.Following' | translate\"></span> </a></li><li class=\"rbx-tab\" id=\"followers\" ng-class=\"{'active': currentData.activeTab == 'followers', 'subtract-item': !currentData.isMyProfile}\" ui-sref=\"followers\"><a class=\"rbx-tab-heading\"> <span class=\"text-lead\" ng-bind=\"'Label.Followers' | translate\"></span> </a></li><li class=\"rbx-tab\" id=\"requests\" ng-class=\"{'active': currentData.activeTab == 'friend-requests', 'subtract-item': !currentData.isMyProfile}\" ng-show=\"currentData.isMyProfile\" ui-sref=\"friend-requests\"><a class=\"rbx-tab-heading\"> <span class=\"text-lead\" ng-bind=\"'Label.Requests' | translate\"></span> </a></li></ul><div class=\"friends-content section\" ng-class=\"{'hide-template': !currentData.templateVisible}\"><div class=\"container-header\"><h3 class=\"friends-subtitle\">{{ currentData.stateLabel }} ({{ friendsContent.friends.data.TotalFriends | number }})</h3><button class=\"btn-fixed-width btn-secondary-xs find-friends-button\" ng-bind=\"'Action.FindFriends' | translate\" ng-click=\"findFriends()\" ng-show=\"currentData.isFindFriendsEnabled\" type=\"button\"></button> <button class=\"btn-fixed-width btn-control-xs ignore-button\" ng-bind=\"'Action.IgnoreAll' | translate\" ng-click=\"declineAllFriendRequests()\" ng-disabled=\"disabled\" ng-show=\"currentData.activeTab == 'friend-requests' &amp;&amp; friendsContent.friends.data.TotalFriends &gt; 0\" type=\"button\"></button> <span class=\"tooltip-container\" data-toggle=\"tooltip\" data-toggle-mobile=\"true\" title=\"{{ currentData.tooltipLabel }}\"> <span class=\"icon-moreinfo\"></span> </span></div><div class=\"tab-content rbx-tab-content container-list\" ui-view=\"\"><ul class=\"hlist avatar-cards\"><li class=\"list-item avatar-card friends-container\" ng-repeat=\"friend in friendsContent.friends.data.Friends\" ng-show=\"friend.UserId &amp;&amp; !currentData.ignoreAll &amp;&amp; friend.isAvailable\"><div class=\"avatar-card-container\" ng-class=\"{'disabled': friend.IsDeleted}\"><div class=\"avatar-card-content\"><div class=\"avatar-card-fullbody\"><a class=\"avatar-card-link\" ng-href=\"{{friend.AbsoluteURL}}\" ng-if=\"!friend.IsDeleted\"> <img class=\"avatar-card-image\" image-retry=\"\" ng-class=\"{'online': friend.isPresenceOnline, 'game': friend.isPresenceGame, 'studio': friend.isPresenceStudio}\" ng-src=\"{{ friend.AvatarUri }}\" thumbnail=\"friend.Thumbnail\"/></a><img class=\"avatar-card-image\" image-retry=\"\" ng-if=\"friend.IsDeleted\" ng-src=\"{{ friend.AvatarUri }}\" thumbnail=\"friend.Thumbnail\"/> <div ng-hide=\"currentData.activeTab === 'followers' || currentData.activeTab === 'friend-requests'\" ng-if=\"!friend.IsDeleted\"><a class=\"avatar-status\" ng-href=\"{{ friend.AbsoluteURL}}\"> <span class=\"icon-online\" ng-show=\"friend.isPresenceOnline\" title=\"{{friend.LastLocation}}\"></span></a> <a class=\"avatar-status\" ng-href=\"{{ friend.AbsolutePlaceURL }}\"><span class=\"icon-game\" ng-show=\"friend.isPresenceGame\" title=\"{{friend.LastLocation}}\"></span></a><div class=\"avatar-status\"><span class=\"icon-studio\" ng-show=\"friend.isPresenceStudio\" title=\"{{friend.LastLocation}}\"></span></div></div></div><div class=\"avatar-card-caption\"><div class=\"text-overflow\" id=\"{{ friend.UserId }}\"><a class=\"avatar-name\" ng-href=\"{{friend.AbsoluteURL}}\" ng-if=\"!friend.IsDeleted\" title=\"{{friend.Username}}\">{{ friend.Username }}</a> <span class=\"avatar-name\" ng-if=\"friend.IsDeleted\" title=\"{{friend.Username}}\">{{ friend.Username }}</span></div><div class=\"avatar-status-container\" ng-if=\"!friend.IsDeleted\"><div class=\"avatar-card-label\" ng-bind=\"friend.lastLocation\" ng-if=\"!(friend.isPresenceGame || friend.isPresenceStudio)\"></div><div ng-if=\"friend.isPresenceGame || friend.isPresenceStudio\"><a class=\"text-link text-overflow avatar-status-link\" ng-bind=\"friend.lastLocation\" ng-href=\"{{ friend.AbsolutePlaceURL }}\" ng-if=\"friend.AbsolutePlaceURL\"> </a> <span class=\"avatar-card-label\" ng-bind=\"friend.lastLocation\" ng-if=\"!friend.AbsolutePlaceURL\"></span></div></div><div class=\"avatar-card-label fail\" ng-bind=\"'Label.Unfollowed' | translate\" ng-cloak=\"\" ng-show=\"currentData.activeTab === 'following' &amp;&amp; !friend.IsFollowed\"></div></div><div card-menu=\"\" class=\"avatar-card-menu\" id=\"{{friend.UserId}}\" ng-if=\"hasMenu(currentData, friend)\"></div></div><div class=\"avatar-card-btns\" ng-show=\"currentData.hasBtns\"><button class=\"btn-control-md ignore-friend\" ng-bind=\"'Action.Ignore' | translate\" ng-click=\"declineFriendRequest(friend.UserId, friend,currentData.currentPage)\" type=\"button\"></button> <button class=\"btn-secondary-md accept-friend\" ng-bind=\"'Action.Accept' | translate\" ng-click=\"acceptFriendRequest(friend.UserId, friend,currentData.currentPage)\" type=\"button\"></button></div></div></li></ul></div></div><div class=\"pager-holder\"><ul class=\"pager\" ng-show=\"currentData.totalPages &gt; 1\"><li class=\"pager-prev\" ng-class=\"{'disabled': disablePrevious()}\"><a ng-click=\"disablePrevious() || newPage('prev')\"><span class=\"icon-left\"></span></a></li><li class=\"pager-cur\"><span>{{(currentData.currentPage / currentData.totalPerPage) + 1}}</span></li><li class=\"pager-total\"><span class=\"fixed-spacing\">/</span> <span>{{currentData.totalPages | number }}</span></li><li class=\"pager-next\" ng-class=\"{'disabled': disableNext()}\"><a ng-click=\"disableNext() || newPage('next')\"><span class=\"icon-right\"></span></a></li></ul></div></div><div captcha=\"\" captcha-model=\"captchaSetting\" captcha-type=\"captchaSetting.captchaType\"></div></div></div>",
