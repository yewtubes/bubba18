{
  "templates": {
    "leave-group-modal": "<div class=modal-header><button type=button class=close ng-click=close()><span class=icon-close></span></button><div class=modal-title><h4 ng-bind=\"'Heading.LeaveGroup' | translate\"></h4></div></div><div class=modal-body><p class=\"body-text text-description\" ng-bind=\"'Description.LeaveGroupWarning' | translate\"><div class=\"border-warning group-modal-warning\" ng-if=params.isOwner><span class=icon-warning-orange></span> <span id=leave-group-as-owner-warning class=\"small text-warning form-warning-text\" ng-bind=\"'Description.LeaveGroupAsOwnerWarning' | translate\"></span></div></div><div class=modal-buttons><button id=leave-group-button type=submit class=\"modal-button btn-secondary-md\" ng-click=leaveGroup() ng-bind=\"'Action.Yes' | translate\"></button> <button type=button class=\"modal-button btn-secondary-md\" ng-click=close() ng-bind=\"'Action.No' | translate\"></button></div>",
    "group-wall": "<div ng-if=canViewWall() ng-controller=groupWallController class=section infinite-scroll=groupWall.pager.loadNextPage() infinite-scroll-disabled=isInfiniteScrollingDisabled() infinite-scroll-distance=0.8><div class=container-header><h3 ng-bind=\"'Heading.Wall' | translate\"></h3></div><div ng-if=showWallPrivacySettingsText() class=section-content-off><a class=text-link ng-href=\"{{ resources.www.privacySettingsUrl }}\" ng-bind=\"'Description.WallPrivacySettings' | translate\"></a></div><div class=\"section-content group-wall group-wall-no-margin\" ng-if=\"groupWall.posts.length > 0 || canPostToWall()\"><div class=\"form-horizontal group-form\" ng-if=canPostToWall() role=form><div class=form-group><captcha activated=groupWall.captchaActivated captcha-action-type=captchaActionTypes.groupWallPost captcha-failed=sendWallPostFailed captcha-passed=sendPostCaptchaPassed></captcha><textarea id=postData ng-model=groupWall.postData ng-disabled=groupWall.isPostInProgress class=\"form-control input-field\" maxlength=\"{{ library.metadata.groupPostMaxLength }}\" placeholder=\"{{ 'Label.WallPostPlaceholder' | translate }}\"></textarea></div><button id=postButton class=\"btn-secondary-md group-form-button\" ng-click=sendPost() ng-disabled=!canSendPost() ng-bind=\"'Action.Post' | translate\"></button></div><div group-comments ng-if=canViewWall()></div></div><div ng-if=canViewWall() class=section-content-off ng-show=\"!groupWall.pager.isBusy() && !groupWall.loadFailure && groupWall.posts.length === 0\" ng-bind=\"'Label.NoWallPosts' | translate\"></div><div ng-if=canViewWall() class=section-content-off ng-show=\"!groupWall.pager.isBusy() && groupWall.loadFailure\" ng-bind=\"'Label.WallPostsUnavailable' | translate\"></div><div class=loading ng-show=groupWall.pager.isBusy()><span class=\"spinner spinner-default\" alt=Processing...></div></div>",
    "group-store-item": "<a href={{item.AbsoluteUrl}} target=_self class=item-card-container><div ng-if=item.AssetStatusIcon class=asset-status-icon><div ng-repeat=\"assetStatusIcon in item.AssetStatusIcon\" ng-class=\"{'has-icon' : assetStatusIcon.ShowTimerIcon, 'has-text' : assetStatusIcon.DisplayText && assetStatusIcon.DisplayText.length > 0}\" class=status-{{assetStatusIcon.CssTag}}><span ng-if=assetStatusIcon.ShowTimerIcon class=icon-clock></span> <span ng-bind=assetStatusIcon.DisplayText></span></div></div><div class=item-card-link><div class=item-card-thumb-container><img class=item-card-thumb ng-src={{item.Thumbnail.Url}} thumbnail=item.Thumbnail image-retry> <span ng-show=item.AssetRestrictionIcon ng-class=\"'icon-' + item.AssetRestrictionIcon.CssTag + '-label'\"></span></div></div><div class=item-card-caption><div class=item-card-name-link><div class=item-card-name title=\"{{ item.Name }}\" ng-bind=item.Name></div></div><div class=\"text-overflow item-card-price\"><span class=\"icon icon-robux\" ng-if=\"item.Price || item.BestPrice\"></span> <span class=text-robux ng-if=\"item.Price && !item.BestPrice\" ng-bind=\"item.Price | number\"></span> <span class=text-robux ng-if=item.BestPrice ng-bind=\"item.BestPrice | number\"></span> <span class=text-label ng-if=\"!item.Price && item.NoPriceText\" ng-class=\"{'text-robux': item.IsFree}\" ng-bind=item.NoPriceText></span></div></div></a>",
    "group-store": "<div ng-controller=groupStoreController class=\"tab-content rbx-tab-content section col-xs-12\"><div class=container-header><h3 ng-bind=\"'Heading.Store' | translate\"></h3></div><div class=section-content ng-if=\"library.currentGroup.permissions.groupEconomyPermissions.createItems && library.currentGroup.permissions.groupEconomyPermissions.manageItems && !library.metadata.isPhone\"><p ng-bind=\"'Description.ClothingRevenue' | translate\"><p><a class=text-link ng-href=\"{{ getDevelopPageUrl() }}\" ng-bind=\"'Label.ManageGroupCreations' | translate\"></a></div><div class=\"spinner spinner-default\" ng-show=layout.isLoading></div><div class=section-content-off ng-show=\"!layout.isLoading && storeData.results.length == 0\" ng-bind=\"layout.loadStoreItemsError ? 'Message.LoadGroupStoreItemsError' : 'Label.NoStoreItems' | translate\"></div><ul class=\"hlist item-cards-stackable\" ng-show=\"storeData.results.length > 0\" ng-class=\"{'faded' : layout.isLoading && !library.metadata.isPhone}\" infinite-scroll=getNextPage() infinite-scroll-disabled=\"!library.metadata.isPhone || Data.activeTab !== groupConstants.currentTab[2]\"><li class=\"list-item item-card\" group-store-item ng-repeat=\"item in storeData.results\"></ul><div ng-show=storeData.showPagination current-page=storeData.query.PageNumber items-per-page=storeData.resultsPerPage num-pages=storeData.numberOfPages model-changed=storeData.updatePagination page-changed=pageChanged is-loading=layout.isLoading show-first-last=layout.showFirstLast pagination></div></div>",
    "group-menu-popover": "<div><ul class=dropdown-menu role=menu><li ng-if=\"isInGroup() && canViewGroupAdmin() && !library.metadata.isPhone && !library.metadata.isConfigureGroupPageEnabled\" id=group-admin><a ng-href=\"{{ groupAdminUrl(library.currentGroup.id) }}\" ng-bind=\"'Action.GroupAdmin' | translate\"></a><li ng-if=\"isInGroup() && canViewGroupAdmin() && !library.metadata.isPhone && library.metadata.isConfigureGroupPageEnabled\" id=configure-group><a ng-href=\"{{ configureGroupUrl(library.currentGroup.id) }}\">Configure Group</a><li ng-if=\"isInGroup() && doesGroupHaveOwner() === false\" id=claim-ownership ng-click=claimOwnership(library.currentGroup.id)><a ng-bind=\"'Action.ClaimOwnership' | translate\"></a><li ng-if=\"isInGroup() && isGroupPrimary()\" id=remove-primary ng-click=removePrimary()><a ng-bind=\"'Action.RemovePrimary' | translate\"></a><li ng-if=\"isInGroup() && !isGroupPrimary()\" id=make-primary ng-click=makePrimary(library.currentGroup.id)><a ng-bind=\"'Action.MakePrimary' | translate\"></a><li ng-if=isInGroup() id=leave-group ng-click=\"showLeaveGroupModal(library.currentGroup.id, library.currentUser.id)\"><a ng-bind=\"'Action.LeaveGroup' | translate\"></a><li ng-if=\"isInGroup() && canAdvertiseGroup() && !library.metadata.isPhone\" id=advertise-group><a ng-href=\"{{ advertiseGroupUrl(library.currentGroup.id) }}\" ng-bind=\"'Action.AdvertiseGroup' | translate\"></a><li ng-if=\"isInGroup() && canViewAuditLogs() && !library.metadata.isPhone && !isConfigureGroupPageEnabled()\" id=audit-log><a ng-href=\"{{ auditLogUrl(library.currentGroup.id) }}\" ng-bind=\"'Action.AuditLog' | translate\"></a><li id=report-abuse ng-click=showReportAbuseModal(library.currentGroup.id)><a ng-bind=\"'Action.ReportAbuse' | translate\"></a></ul></div>",
    "group-games": "<div ng-controller=groupGamesController class=section><div class=container-header><h3 ng-bind=\"'Heading.Games' | translate\"></h3><div class=pager-holder ng-hide=\"gamesPager.isBusy() || (gamesPager.getCurrentPageNumber() === 1 && !gamesPager.canLoadNextPage())\" cursor-pagination=gamesPager></div></div><div class=group-games><div class=\"spinner spinner-default\" ng-show=gamesPager.isBusy()></div><div class=section-content-off ng-show=\"!gamesPager.isBusy() && games.length == 0\" ng-bind=\"layout.loadGamesError ? 'Message.LoadGroupGamesError' : 'Label.NoGames' | translate\"></div><ul class=\"hlist game-cards\" ng-show=\"!gamesPager.isBusy() && games.length > 0\"><li class=list-item ng-repeat=\"game in games\"><group-games-item class=\"game-card game-tile\" game=game></group-games-item></ul></div></div>",
    "group-comments": "<div class=group-comments ng-class=\"{'no-top-border': !library.currentGroup.permissions.groupPostsPermissions.postToWall}\"><div class=\"avatar-container comment\" ng-repeat=\"post in groupWall.posts\"><a ng-href={{profilePageUrl(post.poster.userId)}}><thumbnail-2d thumbnail-type=thumbnailTypes.avatarHeadshot thumbnail-target-id=post.poster.userId size=thumbnailSizes.small></thumbnail-2d></a><div class=wall-comment><div class=group-menu><a tabindex=0 class=rbx-menu-item popover-placement=bottom-right popover-trigger=\"'click : outsideClick'\" uib-popover-template=\"'group-comments-menu-popover'\"><span class=icon-more></span></a></div><div class=wall-comment-name><a ng-href={{profilePageUrl(post.poster.userId)}} class=\"text-name name\">{{ post.poster.username }}</a></div><div class=wall-comment-body ng-bind-html=\"post.body | linkify\"></div><div class=wall-comment-info><div class=\"text-date-hint comment-date\" ng-bind=\"post.posted | formatDate\"></div></div></div></div></div>",
    "group-base": "<div group-data=\"\" ng-class=\"{'group-details-container-desktop-and-tablet': !library.metadata.isPhone}\" ng-cloak=\"\" ng-controller=\"groupController\"><div class=\"create-group-button-container\"><a class=\"btn-control-md create-group-button\" ng-bind=\"'Action.CreateGroup' | translate\" ng-disabled=\"!canCreateGroup()\" ng-href=\"{{ canCreateGroup() ? resources.www.createGroupUrl : '' }}\" ng-if=\"!library.metadata.isPhone\" title=\"{{ createGroupTitle() }}\"></a></div><div class=\"menu-vertical-container\" ng-if=\"isAuthenticatedUser &amp;&amp; !library.metadata.isPhone &amp;&amp; isLoadFinished()\"><groups-list current-group=\"library.currentGroup\" groups=\"library.groupsList.groups\" is-loading-groups=\"layout.isLoadingGroups\" load-more-groups=\"loadMoreGroups\" metadata=\"library.metadata\"></groups-list></div><div class=\"group-details\" ng-class=\"{'group-details-with-list' : currentUserIsInAnyGroup() &amp;&amp; !library.metadata.isPhone,\n                        'group-details-no-list' : !currentUserIsInAnyGroup() &amp;&amp; !library.metadata.isPhone}\" ng-if=\"isLoadFinished()\"><div class=\"alert-system-feedback\"><div class=\"alert alert-warning\"><span class=\"alert-context\" ng-bind=\"'Label.Warning' | translate\"></span> <span class=\"icon-close-white\" id=\"close\"></span></div></div><div class=\"alert-system-feedback\"><div class=\"alert alert-loading\" ng-bind=\"'Label.Loading' | translate\"></div></div><div class=\"alert-system-feedback\"><div class=\"alert alert-success\" ng-bind=\"'Label.Success' | translate\"></div></div><div class=\"section-content\" ng-if=\"isLockedGroup()\"><p ng-bind=\"'Label.GroupLocked' | translate\"></p><button class=\"btn-secondary-md group-button\" id=\"leave-locked-group\" ng-bind=\"'Action.LeaveGroup' | translate\" ng-click=\"showLeaveGroupModal(library.currentGroup.id, library.currentUser.id)\" ng-if=\"isInGroup()\" type=\"submit\"></button></div><div ng-if=\"!isLockedGroup()\"><div class=\"section-content\"><div class=\"hidden\" id=\"page-top\"></div><div class=\"group-header\"><div class=\"group-image\"><thumbnail-2d size=\"thumbnailSizes.large\" thumbnail-target-id=\"library.currentGroup.id\" thumbnail-type=\"thumbnailTypes.groupIcon\"></thumbnail-2d><span class=\"icon-bc-label\" ng-if=\"isGroupBCOnly()\"></span></div><div class=\"group-caption group-caption-with-image\"><h1 class=\"group-name\" ng-bind=\"library.currentGroup.group.name\"></h1><div class=\"group-owner\"><span class=\"text-label\" ng-bind=\"'Label.ByOwner' | translate\"></span> <a class=\"text-name name\" ng-bind=\"library.currentGroup.group.owner.username\" ng-href=\"{{ profilePageUrl(library.currentGroup.group.owner.userId) }}\" ng-if=\"doesGroupHaveOwner()\"></a> <span class=\"group-owner-name\" ng-bind=\"'Label.NoOne' | translate\" ng-if=\"doesGroupHaveOwner() === false\"></span></div><div class=\"group-info\"><div class=\"dynamic-overflow-container no-wrap group-stats\"><div class=\"dynamic-width-item group-members\" ng-class=\"{'border-right' : library.metadata.isPhone &amp;&amp; isInGroup(), 'group-guest' : !isInGroup() }\"><div class=\"text-label font-caption-header\" ng-bind=\"'Heading.Members' | translate\"></div><h3 class=\"font-caption-body\" ng-bind=\"library.currentGroup.group.memberCount | abbreviate\" title=\"{{ library.currentGroup.group.memberCount }}\"></h3></div><div class=\"dynamic-ellipsis-item group-rank\" ng-if=\"isInGroup()\"><div class=\"text-label font-caption-header\" ng-bind=\"'Heading.Rank' | translate\"></div><h3 class=\"text-overflow font-caption-body\" ng-bind=\"library.currentGroup.role.name\" title=\"{{ library.currentGroup.role.name }}\"></h3></div></div><div class=\"group-membership\" ng-if=\"isAuthenticatedUser &amp;&amp; !isInGroup()\"><a class=\"btn-secondary-md group-button\" ng-bind=\"'Action.Upgrade' | translate\" ng-href=\"{{ resources.www.upgradeMembershipUrl }}\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.maxGroupsNeedUpgrade\" type=\"button\"></a> <button class=\"btn-secondary-md group-button\" id=\"group-join-button\" ng-bind=\"'Action.JoinGroup' | translate\" ng-click=\"joinGroup()\" ng-disabled=\"isCaptchaActive()\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.allowed\" type=\"submit\"></button><captcha activated=\"captcha.activated\" captcha-action-type=\"captchaActionTypes.groupJoin\" captcha-failed=\"joinGroupCaptchaFailed\" captcha-passed=\"joinGroupCaptchaPassed\" ng-if=\"library.metadata.isFunCaptchaEnabled &amp;&amp; showJoinGroupButtonUI() == groupConstants.joinStatus.allowed\"></captcha><span class=\"small text group-membership-text\" ng-bind=\"library.currentUser.maxGroupsText\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.maxGroupsNeedUpgrade || showJoinGroupButtonUI() == groupConstants.joinStatus.maxGroups\"></span> <a class=\"btn-secondary-md group-button\" ng-bind=\"'Action.UpgradeToJoin' | translate\" ng-href=\"{{ resources.www.upgradeMembershipUrl }}\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.restricted\" type=\"button\"></a> <button class=\"btn-secondary-md group-button\" ng-bind=\"'Action.CancelRequest' | translate\" ng-click=\"cancelJoinRequest(library.currentGroup.id, library.currentUser.id)\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.joinPending\" type=\"button\"></button> <span class=\"small group-membership-text\" ng-bind=\"'Label.OnlyBcCanJoin' | translate\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.restricted &amp;&amp; !library.isRobloxPremiumEnabledForUser\"></span> <span class=\"small group-membership-text\" ng-bind=\"'Label.OnlyPremiumCanJoin' | translate\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.restricted &amp;&amp; library.isRobloxPremiumEnabledForUser\"></span> <span class=\"small group-membership-text\" ng-bind=\"'Label.GroupClosed' | translate\" ng-if=\"showJoinGroupButtonUI() == groupConstants.joinStatus.groupClosed\"></span></div></div></div><div class=\"group-menu\"><a class=\"rbx-menu-item\" popover-placement=\"bottom-right\" popover-trigger=\"'click : blur'\" tabindex=\"0\" uib-popover-template=\"'group-menu-popover'\"><span class=\"icon-more\"></span></a></div></div></div><div class=\"rbx-tabs-horizontal\"><ul class=\"nav nav-tabs\" id=\"horizontal-tabs\" role=\"tablist\"><li class=\"rbx-tab group-tab\" id=\"about\" ng-class=\"{'active': Data.activeTab === groupConstants.currentTab[1] }\" ui-sref=\"about\"><a class=\"rbx-tab-heading\"><span class=\"text-lead\" ng-bind=\"'Heading.About' | translate\"></span></a><li class=\"rbx-tab group-tab\" id=\"store\" ng-class=\"{'active': Data.activeTab === groupConstants.currentTab[2] }\" ui-sref=\"store\"><a class=\"rbx-tab-heading\"><span class=\"text-lead\" ng-bind=\"'Heading.Store' | translate\"></span></a><li class=\"rbx-tab group-tab\" id=\"affiliates\" ng-class=\"{'active': Data.activeTab === 'affiliates'}\" ui-sref=\"affiliates\"><a class=\"rbx-tab-heading\"><span class=\"text-lead\" ng-bind=\"'Heading.Affiliates' | translate\"></span></a></li></li><li class=\"rbx-tab group-tab\" id=\"games\" ng-class=\"{'active': Data.activeTab === 'games'}\" ui-sref=\"games\"><a class=\"rbx-tab-heading\"><span class=\"text-lead\" ng-bind=\"'Heading.Games' | translate\"></span></a><li class=\"rbx-tab group-tab\" id=\"affiliates\" ng-class=\"{'active': Data.activeTab === groupConstants.currentTab[3] }\" ui-sref=\"affiliates\"><a class=\"rbx-tab-heading\"><span class=\"text-lead\" ng-bind=\"'Heading.Affiliates' | translate\"></span></a></li></li></li></ul></div><div group-about=\"\" ng-if=\"Data.activeTab === groupConstants.currentTab[1]\"></div><div group-games=\"\" ng-if=\"Data.activeTab === 'games'\"></div><div group-store=\"\" ng-if=\"Data.activeTab === groupConstants.currentTab[2]\"></div><div class=\"tab-content rbx-tab-content section col-xs-12\" ng-if=\"Data.activeTab === 'affiliates'\"><group-affiliates group-id=\"library.currentGroup.id\" no-affiliates-message=\"'Label.NoAllies'\" relationship-type=\"groupConstants.relationshipType.allies\" section-title=\"'Heading.Allies'\"></group-affiliates><group-affiliates group-id=\"library.currentGroup.id\" ng-if=\"library.currentGroup.areEnemiesAllowed\" no-affiliates-message=\"'Label.NoEnemies'\" relationship-type=\"groupConstants.relationshipType.enemies\" section-title=\"'Heading.Enemies'\"></group-affiliates></div></div></div></div>",
    "group-about": "<div class=\"tab-content rbx-tab-content col-xs-12\"><div class=\"section\" ng-if=\"canViewStatus() || (canPostToStatus())\"><div class=\"container-header\"><h3 ng-bind=\"'Heading.Shout' | translate\"></h3></div><div class=\"section-content shout-container\"><thumbnail-2d ng-if=\"canViewStatus()\" size=\"thumbnailSizes.small\" thumbnail-target-id=\"library.currentGroup.group.shout.poster.userId\" thumbnail-type=\"thumbnailTypes.avatarHeadshot\"></thumbnail-2d><div class=\"group-shout\" ng-if=\"canViewStatus()\"><div class=\"group-shout-name\"><a class=\"text-name name\" ng-href=\"{{profilePageUrl(library.currentGroup.group.shout.poster.userId)}}\">{{library.currentGroup.group.shout.poster.username}}</a></div><div class=\"group-shout-body\" ng-bind-html=\"library.currentGroup.group.shout.body | linkify\"></div><div class=\"group-shout-info\"><div class=\"text-date-hint shout-date\" ng-bind=\"library.currentGroup.group.shout.updated | formatDate\"></div></div></div><div class=\"form-horizontal group-form\" ng-if=\"canPostToStatus()\" role=\"form\"><div class=\"form-group\" ng-class=\"{'form-group-no-status' : !canViewStatus()}\"><textarea class=\"form-control input-field\" maxlength=\"{{library.metadata.groupStatusMaxLength}}\" ng-init=\"library.currentGroup.group.shout.shoutData = ''\" ng-model=\"library.currentGroup.group.shout.shoutData\" placeholder=\"{{ 'Label.ShoutPlaceholder' | translate }}\"></textarea></div><button class=\"btn-secondary-md group-form-button\" ng-bind=\"'Action.GroupShout' | translate\" ng-click=\"sendGroupShout()\"></button></div></div></div><div class=\"section\" ng-if=\"library.currentGroup.group.description || currencyInRobux !== null\"><div class=\"container-header\"><h3 ng-bind=\"'Heading.Description' | translate\"></h3></div><div class=\"section-content\"><div class=\"group-description\" ng-bind-html=\"library.currentGroup.group.description | linkify\"></div><ul class=\"border-top group-detail-stats\" ng-if=\"currencyInRobux !== null\"><li class=\"group-detail-stat col-xs-6 col-md-2\"><p class=\"text-label font-caption-header\" ng-bind=\"'Label.Funds' | translate\"><p class=\"text-lead\"><h3 class=\"icon-text-wrapper\" title=\"R$ {{ currencyInRobux | number }}\"><span class=\"icon-robux\"></span> <span class=\"text-robux-lg\" ng-bind=\"currencyInRobux | abbreviate\"></span></h3></p></p></li></ul></div></div><div class=\"clearfix\"></div><group-members-list group-id=\"library.currentGroup.id\" is-authenticated-user=\"isAuthenticatedUser\" ng-if=\"library.currentGroup.roles\" roles=\"library.currentGroup.roles\"></group-members-list><div group-wall=\"\"></div></div>",
    "groups-list-item": "<a target=_self class=group-name-link ng-href=\"{{ $ctrl.group.groupUrl }}\" title=\"{{ $ctrl.group.name }}\"><div class=\"menu-option-content group-card\"><thumbnail-2d thumbnail-type=$ctrl.thumbnailTypes.groupIcon thumbnail-target-id=$ctrl.group.id size=$ctrl.thumbnailSizes.small></thumbnail-2d><span class=\"font-caption-header group-card-name text-overflow\" ng-bind=$ctrl.group.name></span></div></a>",
    "groups-list": "<div class=loading ng-show=$ctrl.isLoadingGroups><span class=\"spinner spinner-default\" alt=Processing...></div><ul ng-if=!$ctrl.metadata.isPhone id=groups-list class=\"group-cards menu-vertical rbx-scrollbar\" ng-cloak infinite-scroll=$ctrl.loadMoreGroups() infinite-scroll-disabled=$ctrl.isLoadingGroups infinite-scroll-distance=0.5 data-toggle=scrollbar><li class=\"menu-option list-item\" ng-repeat=\"group in $ctrl.groups\" ng-class=\"{ 'primary-group': group.isPrimary,\n                            'active': group.id === $ctrl.currentGroup.id}\"><groups-list-item group=group></groups-list-item></ul><h3 ng-if=\"$ctrl.metadata.isPhone && $ctrl.groups[0].isPrimary\" class=primary-group-title ng-bind=\"'Heading.Primary' | translate\"></h3><ul ng-if=$ctrl.metadata.isPhone id=groups-list class=\"group-cards hlist\" ng-cloak infinite-scroll=$ctrl.loadMoreGroups() infinite-scroll-disabled=$ctrl.isLoadingGroups infinite-scroll-distance=0.5 data-toggle=scrollbar><li class=list-item ng-repeat=\"group in $ctrl.groups\" ng-class=\"{ 'border-bottom primary-group': group.isPrimary }\"><a target=_self class=group-name-link ng-href=\"{{ group.groupUrl }}\"><div class=group-card><thumbnail-2d thumbnail-type=$ctrl.thumbnailTypes.groupIcon thumbnail-target-id=group.id size=$ctrl.thumbnailSizes.medium></thumbnail-2d><div class=group-card-container><div class=group-card-text><h5 class=\"group-card-name text-overflow\" ng-bind=group.name></h5><span class=\"text-label text-overflow font-caption-body\" ng-bind-template=\"{{ 'Heading.Rank' | translate }}: {{ group.rank }}\"></span></div><div class=group-card-members><div class=members-icon><span class=icon-nav-group></span></div><span class=members-count ng-bind=\"group.members | abbreviate\"></span></div></div></div></a></ul>",
    "group-members-list": "<div class=\"section\" ng-hide=\"$ctrl.numGroupMembers == 0\"><div class=\"container-header group-members-list-container-header\"><h3 ng-bind=\"('Heading.Members' | translate) + ' (' + $ctrl.numGroupMembers + ')'\"></h3><div class=\"pager-holder\" ng-hide=\"$ctrl.membersPager.isBusy() || ($ctrl.membersPager.getCurrentPageNumber() === 1 &amp;&amp; !$ctrl.membersPager.canLoadNextPage())\"><ul class=\"pager\"><li class=\"pager-prev\" ng-class=\"{ disabled: !$ctrl.membersPager.canLoadPreviousPage() }\"><a ng-click=\"$ctrl.membersPager.loadPreviousPage()\"><span class=\"icon-back\"></span></a><li><span ng-bind=\"'Label.CurrentPage' | translate:{ currentPage: $ctrl.membersPager.getCurrentPageNumber() }\"></span><li class=\"pager-next\" ng-class=\"{ disabled: !$ctrl.membersPager.canLoadNextPage() }\"><a ng-click=\"$ctrl.membersPager.loadNextPage()\"><span class=\"icon-next\"></span></a></li></li></li></ul></div><div class=\"input-group-btn group-dropdown\"><button class=\"input-dropdown-btn\" data-toggle=\"dropdown\" type=\"button\"><span class=\"rbx-selection-label\" ng-bind=\"$ctrl.data.currentRoleName\" title=\"{{ $ctrl.data.currentRoleName }}\"></span> <span class=\"icon-down-16x16\"></span></button><ul class=\"dropdown-menu\" data-toggle=\"dropdown-menu\" role=\"menu\"><li id=\"role-{{ role.id }}\" ng-repeat=\"role in $ctrl.roles\"><a ng-click=\"$ctrl.updateRole(role)\"><span class=\"text-overflow\" ng-bind=\"role.name\"></span> <span class=\"role-member-count\" ng-if=\"role.memberCount\">({{ role.memberCount | abbreviate }})</span></a></li></ul></div></div><div class=\"spinner spinner-default\" ng-show=\"$ctrl.membersPager.isBusy() &amp;&amp; $ctrl.members.length == 0\"></div><div class=\"section-content-off\" ng-bind=\"$ctrl.loadMembersError ? 'Message.BuildGroupRolesListError' : 'Label.NoMembersInRole' | translate\" ng-show=\"!$ctrl.membersPager.isBusy() &amp;&amp; $ctrl.members.length == 0\"></div><div class=\"section-content group-members-list\" ng-show=\"$ctrl.members.length &gt; 0\"><ul class=\"hlist\"><li class=\"list-item member\" id=\"member-{{ member.userId }}\" ng-repeat=\"member in $ctrl.members\"><div class=\"avatar-container\" title=\"{{ member.username }}\"><a ng-href=\"{{ $ctrl.profilePageUrl(member.userId) }}\"><span class=\"avatar-card-link-spanner\"></span></a><div class=\"avatar avatar-card-fullbody\"><thumbnail-2d size=\"$ctrl.thumbnailSizes.large\" thumbnail-target-id=\"member.userId\" thumbnail-type=\"$ctrl.thumbnailTypes.avatarHeadshot\"></thumbnail-2d><a class=\"avatar-status\"><span class=\"icon-online\" ng-show=\"member.presence.locationType === 1\"></span></a> <a class=\"avatar-status\"><span class=\"icon-game\" ng-show=\"member.presence.locationType === 2\"></span></a> <a class=\"avatar-status\"><span class=\"icon-studio\" ng-show=\"member.presence.locationType === 3\"></span></a></div><span class=\"text-overflow font-caption-header member-name\" ng-bind=\"member.username\"></span></div></li></ul></div></div>",
    "group-games-item": "<div class=game-card-container><a ng-href=\"{{ $ctrl.game.gameReferralUrl }}\" ng-click=$ctrl.goToGameDetails() class=game-card-link><thumbnail-2d thumbnail-type=$ctrl.thumbnailTypes.gameIcon thumbnail-target-id=$ctrl.game.id size=$ctrl.thumbnailSizes.large></thumbnail-2d><div class=\"game-card-name game-name-title\" title=\"{{ $ctrl.game.name }}\" ng-bind=$ctrl.game.name></div><div class=game-card-info><span class=\"info-label icon-votes-gray\"></span> <span class=\"info-label vote-percentage-label\" ng-if=$ctrl.game.votes.votePercentage ng-bind=$ctrl.game.votes.votePercentage></span> <span class=\"info-label no-vote\" ng-if=!$ctrl.game.votes.votePercentage></span> <span class=\"info-label icon-playing-counts-gray\"></span> <span class=\"info-label playing-counts-label\" title=\"{{ $ctrl.game.playing | number }}\" ng-bind=\"$ctrl.game.playing | abbreviate : { decimalPlaces: 1 }\"></span></div></a></div>",
    "group-affiliates": "<div class=container-header><h3 ng-bind=\"$ctrl.sectionTitle | translate\"></h3><div class=pager-holder ng-hide=\"$ctrl.affiliatesPager.isBusy() || ($ctrl.affiliatesPager.getCurrentPageNumber() === 1 && !$ctrl.affiliatesPager.canLoadNextPage())\"><ul class=pager><li class=pager-prev ng-class=\"{ disabled: !$ctrl.affiliatesPager.canLoadPreviousPage() }\"><a ng-click=$ctrl.affiliatesPager.loadPreviousPage()><span class=icon-back></span></a><li><span ng-bind=\"'Label.CurrentPage' | translate:{ currentPage: $ctrl.affiliatesPager.getCurrentPageNumber() }\"></span><li class=pager-next ng-class=\"{ disabled: !$ctrl.affiliatesPager.canLoadNextPage() }\"><a ng-click=$ctrl.affiliatesPager.loadNextPage()><span class=icon-next></span></a></ul></div></div><div class=group-affiliates><div class=\"spinner spinner-default\" ng-show=$ctrl.affiliatesPager.isBusy()></div><div class=section-content-off ng-show=\"!$ctrl.affiliatesPager.isBusy() && $ctrl.affiliates.length == 0\" ng-bind=\"$ctrl.loadAffiliatesError ? 'Message.GetGroupRelationshipsError' : $ctrl.noAffiliatesMessage | translate\"></div><ul class=\"hlist game-cards\" ng-show=\"!$ctrl.affiliatesPager.isBusy() && $ctrl.affiliates.length > 0\"><li class=list-item ng-repeat=\"group in $ctrl.affiliates\"><group-affiliate-card class=\"game-card game-tile\" group=group></group-affiliate-card></ul></div>",
    "rbx-cursor-pagination": "<ul class=pager><li class=pager-prev ng-class=\"{ disabled: !cursorPaging.canLoadPreviousPage() }\"><a ng-click=cursorPaging.loadPreviousPage()><span class=icon-back></span></a><li><span ng-bind=\"'Label.CurrentPage' | translate:{ currentPage: cursorPaging.getCurrentPageNumber() }\"></span><li class=pager-next ng-class=\"{ disabled: !cursorPaging.canLoadNextPage() }\"><a ng-click=cursorPaging.loadNextPage()><span class=icon-next></span></a></ul>",
    "2d-thumbnail": "<span ng-class=\"$ctrl.getCssClasses()\" thumbnail-type=\"{{ $ctrl.thumbnailType }}\" thumbnail-target-id=\"{{ $ctrl.thumbnailTargetId }}\" size=\"{{ $ctrl.size }}\"> <img ng-if=\"$ctrl.thumbnailUrl\" ng-src=\"{{ $ctrl.thumbnailUrl }}\"/> </span>"
  },
